<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Position GPS : écran de diagnostic, puis détection des lieux (phase 4). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Afficher l'état du réseau (Wi-Fi ou hors ligne) ; aucune connexion n'est requise. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Synchroniser le paquet de contenu depuis le dépôt, en Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Mettre la photo du jour en fond de l'écran verrouillé (réglage facultatif). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <queries>
        <!-- Savoir si les services Google sont présents, sans en dépendre. -->
        <package android:name="com.google.android.gms" />
        <!-- Demander au guide (DeepSeek) et traduction (Google Traduction), si installés. -->
        <package android:name="com.deepseek.chat" />
        <package android:name="com.google.android.apps.translate" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Ouvrir les liens externes du carnet (Amap, sites de réservation). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Écran « Applications » : lister les applis installées (TravelOS est l'écran d'accueil). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TravelOsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="TravelOS"
        android:largeHeap="true"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.TravelOS">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- TravelOS peut devenir l'écran d'accueil de la tablette. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Économiseur d'écran TravelOS (Réglages › Affichage › Économiseur d'écran). -->
        <service
            android:name=".TravelDream"
            android:exported="true"
            android:label="TravelOS"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
